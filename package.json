{
  "name": "games",
  "version": "1.0.0",
  "description": "What’s in the backlog?",
  "source": "src/index.html",
  "private": true,
  "scripts": {
    "clean": "del dist/*",
    "ts-check": "tsc --project tsconfig.json",
    "lint": "prettier --check . && npm run oxlint && npm run ts-check",
    "test": "npm run lint && jest",
    "format": "prettier --write .",
    "prestart": "npm run clean && npm run lint",
    "start": "parcel",
    "prebuild": "npm run clean && npm run lint",
    "build": "parcel build --no-cache --public-url /games/",
    "oxlint": "oxlint --type-aware"
  },
  "author": "Alex Gibson",
  "repository": {
    "type": "git",
    "url": "https://github.com/alexgibson/games.git"
  },
  "licenses": [
